{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "python": "3.12",
    "node": "20"
  },
  "steps": {
    "install": {
      "commands": [
        "npm ci --prefix frontend"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["npm run build --prefix frontend"]
    }
  },
  "deploy": {
    "startCommand": "python -m uvicorn backend.app.main:app --host 0.0.0.0 --port $PORT",
    "inputs": [
      { "step": "build", "include": ["."] }
    ]
  }
}
